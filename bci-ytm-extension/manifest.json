{
  "manifest_version": 3,
  "name": "BCI YT Music Controller",
  "version": "0.1.0",
  "description": "用腦波（眨眼）控制 YouTube Music 網頁版的播放，需搭配 bci_server.py 後端。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BCI YT Music Controller"
  },
  "background": {
    "service_worker": "background.js"
  }
}
